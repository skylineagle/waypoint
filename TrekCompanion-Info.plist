<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>JourneyKeychainGroup</key>
	<string>$(AppIdentifierPrefix)dev.horizon.trekcompanion.journey</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.horizon.trekcompanion</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trekcompanion</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Finds the photos you took at each place so you can add them to your Journey.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scans your receipts so their total, place and date fill in for you.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Marks today's stops done after you spend time there, even when the app is closed.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Shows where you are among today's stops.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
